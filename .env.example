# ============================================
# Typecho 数据库配置
# ============================================
TYPECHO_DB_HOST=localhost
TYPECHO_DB_PORT=3306
TYPECHO_DB_USER=user
TYPECHO_DB_PASSWORD=password
TYPECHO_DB_NAME=typecho
TYPECHO_DB_CHARSET=utf8mb4
# 表前缀（与 config.inc.php 中 $db = new Typecho_Db('Pdo_Mysql', 'typecho_') 一致）
TYPECHO_TABLE_PREFIX=typecho_

# 默认作者（typecho_users.uid），新增文章时会使用该 uid 作为 authorId
TYPECHO_DEFAULT_AUTHOR_ID=1
# 默认分类（typecho_metas.mid, type='category'），新增文章时会使用该 mid 作为默认分类
TYPECHO_DEFAULT_CATEGORY_ID=1

# ---- 连接超时（秒）。不设的话 MySQL/网络一卡住，工作线程会永久挂起，
# ---- 线程耗光后进程还在但不响应任何请求（表现为「服务挂了」）。
TYPECHO_DB_CONNECT_TIMEOUT=5
TYPECHO_DB_READ_TIMEOUT=15
TYPECHO_DB_WRITE_TIMEOUT=15
# 每个 worker 的连接池上限。注意 上限 × worker 数 × 进程数 不能超过 MySQL max_connections
TYPECHO_DB_POOL_MAX=10
# 池满时最多等多久（秒），超时快速失败，不会把整个服务拖成无响应
TYPECHO_DB_POOL_WAIT_TIMEOUT=5

# ============================================
# API Key 鉴权
# ============================================
# 多个 key 用英文逗号分隔。Agent 需在 HTTP Header 中带上： X-API-Key: <key>
API_KEYS=sk-please-change-me-1,sk-please-change-me-2

# 允许来源（防止 CSRF / 简单白名单），多个用逗号分隔，留空表示不限制
ALLOWED_ORIGINS=*

# ============================================
# 腾讯云 COS 配置
# ============================================
# 在 https://console.cloud.tencent.com/cam/capi 申请子账号密钥
COS_SECRET_ID=<your-tencent-cloud-secret-id>
COS_SECRET_KEY=<your-tencent-cloud-secret-key>
COS_REGION=ap-guangzhou
COS_BUCKET=<your-bucket-name-1250000000>
# 访问协议：https | http
COS_SCHEME=https
# 上传目录前缀，例如 blog/
COS_KEY_PREFIX=blog/
# 访问 CDN 域名（可选），为空时使用 COS 默认域名：<Bucket>-<AppId>.cos.<Region>.myqcloud.com
COS_CDN_DOMAIN=
# COS HTTP 超时（秒）。SDK 默认无超时，网络抖动会把线程永久卡住
COS_TIMEOUT=20

# ============================================
# HTTP 服务
# ============================================
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
# 产线必须为 false：true 会开启 Werkzeug 调试器，出错时等于给了对方一个交互式 shell
HTTP_DEBUG=false

# 单个请求体 / 单张图片的大小上限（MB）。Flask 默认不限制，
# 一个几十 MB 的请求就能把内存打满导致进程被系统杀掉。
MAX_UPLOAD_MB=20

# 是否允许 upload_image_from_file 从服务端文件系统读文件上传。
# 产线必须保持 false（agent 一旦能调就能 exfiltrate 任意文件到 COS）。
# 本地开发自己跑想用本地图时改 true。
ALLOW_LOCAL_UPLOAD=false
